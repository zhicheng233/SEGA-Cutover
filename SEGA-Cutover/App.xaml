<Application x:Class="SEGA_Cutover.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SEGA_Cutover"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="Font1">/SEGA_Cutover;component/res/#Maple Mono Normal NF CN</FontFamily>
        <FontFamily x:Key="JetBrainsMonoBold">/SEGA_Cutover;component/res/#JetBrains Mono NL Bold</FontFamily>
        <FontFamily x:Key="JetBrainsMonoExtraLight">/SEGA_Cutover;component/res/#JetBrains Mono NL ExtraLight</FontFamily>
    </Application.Resources>
</Application>
